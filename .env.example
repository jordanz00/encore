# Encore — environment variables (development defaults)
# Copy to .env.local and fill in real secrets. NEVER commit .env.local.

# === Core ===
NODE_ENV=development
APP_NAME=Encore
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# === Database (Postgres) ===
DATABASE_URL=postgres://encore:encore@localhost:5432/encore

# === Redis (queue + cache) ===
REDIS_URL=redis://localhost:6379

# === Object storage (S3-compatible; MinIO defaults) ===
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_UPLOADS=encore-uploads
S3_BUCKET_AUDIO=encore-audio
S3_BUCKET_IMAGES=encore-images
S3_FORCE_PATH_STYLE=true

# === Search (Meilisearch) ===
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=local-dev-master-key-change-me

# === Auth (Better-Auth) ===
AUTH_SECRET=replace-with-openssl-rand-hex-32
AUTH_TRUST_HOST=true
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# === Email (Mailhog in dev; SMTP in prod) ===
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@encore.local

# === Payments (Stripe Connect — leave empty in dev) ===
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=
WEB_PUBLIC_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
CDN_BASE_URL=http://localhost:3001/media
MEDIA_PRESIGN_TTL_SEC=3600

# === Beta gate (ship week) ===
BETA_SIGNUP_REQUIRED=false
WAITLIST_EXPORT_TOKEN=

# === Subsonic (optional password for /rest) ===
SUBSONIC_PASSWORD=

# === Build / ops ===
GIT_SHA=dev

# === Audio pipeline ===
FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
HLS_LADDERS=320,256,128,64
ENABLE_FLAC=true
ENABLE_BINAURAL=false
EBU_R128_TARGET_LUFS=-14
AUDIO_TARGET_LUFS=-14
TRANSCODE_CONCURRENCY=2
PODCAST_CONCURRENCY=4
DDEX_CONCURRENCY=2
OUTBOX_CONCURRENCY=4

# === Privacy + analytics ===
ANALYTICS_PROVIDER=plausible
PLAUSIBLE_DOMAIN=encore.local
DISABLE_DETAILED_PLAY_TRACKING=true

# === Federation (ActivityPub — disabled by default in dev) ===
ENABLE_ACTIVITYPUB=false
ACTIVITYPUB_DOMAIN=encore.local
ACTIVITYPUB_BASE_URL=https://encore.local

# === Moderation (NCMEC PhotoDNA — leave empty in dev) ===
NCMEC_API_KEY=
NCMEC_REPORTING_ORG_ID=

# === Catalog ingestion ===
ENABLE_DDEX_INGEST=false
ENABLE_PODCAST_INGEST=true
ENABLE_CC_SEED_IMPORT=false

# === Catalog seed sources ===
# Free Music Archive: bundled curated subset by default; override URL for full set.
FMA_TRACKS_CSV_URL=
FMA_AUDIO_BASE_URL=https://archive.org/download/fma_small
# Jamendo: free dev client id required for live API; otherwise curated fallback only.
JAMENDO_CLIENT_ID=
