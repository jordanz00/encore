{
  "$schema": "https://schema.tauri.app/config/2.0",
  "productName": "Encore",
  "version": "0.0.1",
  "identifier": "fm.encore.desktop",
  "build": {
    "beforeDevCommand": "echo 'open http://localhost:3000 in the wrapped webview'",
    "beforeBuildCommand": "echo 'point devUrl/frontendDist at apps/web build'",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../web/.next"
  },
  "app": {
    "windows": [
      {
        "title": "Encore",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' http://localhost:3000 http://localhost:3001 ws://localhost:3000; img-src 'self' data: blob: http://localhost:9000; media-src 'self' blob: http://localhost:9000; connect-src 'self' http://localhost:3001 ws://localhost:3000"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis", "deb", "appimage"],
    "icon": ["icons/icon.png"],
    "category": "Music",
    "shortDescription": "Encore — open-source music",
    "longDescription": "Encore desktop client. AGPL-3.0."
  }
}
