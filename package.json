{
  "name": "encore",
  "private": true,
  "version": "0.0.1",
  "description": "Encore — open-source, artist-first music platform. Every artist deserves an encore. AGPL-3.0.",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.10.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "compose:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "compose:down": "docker compose -f infra/docker/docker-compose.yml down",
    "compose:logs": "docker compose -f infra/docker/docker-compose.yml logs -f",
    "db:migrate": "pnpm --filter @encore/db migrate",
    "db:seed": "pnpm --filter @encore/db seed",
    "seed:catalog": "pnpm --filter @encore/seed-catalog seed -- --source=all --limit=50",
    "swarm:seed": "pnpm --filter @encore/agents-system seed",
    "swarm:cycle": "pnpm --filter @encore/agents-system cycle",
    "swarm:dry-run": "pnpm --filter @encore/agents-system cycle -- --dry-run",
    "swarm:daemon": "pnpm --filter @encore/agents-system daemon",
    "swarm:status": "pnpm --filter @encore/agents-system status",
    "agents:cycle": "node agents/encore/cycle.js"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "prettier": "^3.3.3",
    "@types/node": "^20.16.5"
  }
}
